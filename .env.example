# Game Night Board — optional configuration (placeholders only).
# The server reads plain environment variables; copy these into your
# shell, your host's env settings, or an .env file if your setup loads one.

# Port the server listens on.
PORT=3000

# Where board state is stored (relative to the project folder by default).
# DATA_FILE=data.json

# Timezone used for "today" — set to the store's timezone if the host
# computer is somewhere else.
# TZ=America/Los_Angeles
